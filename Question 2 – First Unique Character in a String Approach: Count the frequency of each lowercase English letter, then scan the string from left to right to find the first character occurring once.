
public class FirstUniqueCharacter {
    public static void main(String[] args) {
        String s = "loveleetcode";
        int[] freq = new int[26];

        for (char c : s.toCharArray()) {
            freq[c - 'a']++;
        }

        int result = -1;

        for (int i = 0; i < s.length(); i++) {
            if (freq[s.charAt(i) - 'a'] == 1) {
                result = i;
                break;
            }
        }

        System.out.println(result);
    }
}
